{
  "name": "derrick-kempf-art-feed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file=.env.local scripts/migrate-from-supabase.mjs",
    "sync-schema": "rm -rf studio/schemaTypes && cp -R sanity/schemaTypes studio/schemaTypes && cp sanity/structure.ts studio/structure.ts",
    "studio": "npm --prefix studio run dev"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.17.0",
    "@sanity/icons": "^5.4.0",
    "@sanity/image-url": "^2.2.0",
    "@sanity/vision": "^6.24.0",
    "next": "^16.4.6",
    "next-sanity": "^13.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.24.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
